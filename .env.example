# ═══════════════════════════════════════════════════════════
# Multi-Chain Claim Platform — Environment Variables
# ═══════════════════════════════════════════════════════════

# ── Database ──
DATABASE_URL=postgresql://user:password@localhost:5432/claim_platform

# ── Redis (rate limiting, caching, queues) ──
REDIS_URL=redis://localhost:6379

# ── API ──
API_PORT=4000
JWT_SECRET=your-jwt-secret-here
ADMIN_JWT_SECRET=your-admin-jwt-secret-here

# ── RPC Providers (with failover) ──
# EVM
ETH_RPC_1=https://mainnet.infura.io/v3/YOUR_KEY
ETH_RPC_2=https://eth.public.rpc.nexa.network
BSC_RPC_1=https://bsc-dataseed1.binance.org
BSC_RPC_2=https://bsc-dataseed2.binance.org
BASE_RPC_1=https://mainnet.base.org
BASE_RPC_2=https://base.public.rpc.nexa.network
ARBITRUM_RPC_1=https://arb1.arbitrum.io/rpc
POLYGON_RPC_1=https://polygon-rpc.com
AVALANCHE_RPC_1=https://api.avax.network/ext/bc/C/rpc
OPTIMISM_RPC_1=https://mainnet.optimism.io

# Non-EVM
SOLANA_RPC_1=https://api.mainnet-beta.solana.com
SOLANA_RPC_2=https://solana-mainnet.g.alchemy.com/v2/YOUR_KEY

# ── Frontend ──
NEXT_PUBLIC_API_URL=http://localhost:4000/api
NEXT_PUBLIC_WC_PROJECT_ID=your-walletconnect-project-id

# ── Security ──
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=30
CAPTCHA_SECRET=your-captcha-secret

# ── Admin ──
ADMIN_WALLET_ADDRESSES=0x1234...  # comma-separated admin wallets
