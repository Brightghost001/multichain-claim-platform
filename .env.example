# ═══════════════════════════════════════════════════════════
# Environment Variables — Multi-Chain Claim Platform
# ═══════════════════════════════════════════════════════════

# ── MongoDB Atlas ──
MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/claim-platform

# ── API ──
API_PORT=4000
FRONTEND_URL=http://localhost:3000

# ── Rate Limiting ──
RATE_LIMIT_MAX=30
RATE_LIMIT_WINDOW_MS=1 minute

# ── Admin ──
ADMIN_WALLET_ADDRESSES=0x...

# ── Contract Deployment ──
DEPLOYER_PRIVATE_KEY=0x...
CLAIM_TOKEN_ADDRESS=0x...
CLAIM_MERKLE_ROOT=0x...
CLAIM_DEADLINE=1800000000

# ── RPC Endpoints (for blockchain monitor) ──
ETH_RPC_1=https://eth.llamarpc.com
BSC_RPC_1=https://bsc-dataseed.binance.org
BASE_RPC_1=https://mainnet.base.org
ARBITRUM_RPC_1=https://arb1.arbitrum.io/rpc
POLYGON_RPC_1=https://polygon-rpc.com
AVALANCHE_RPC_1=https://api.avax.network/ext/bc/C/rpc
OPTIMISM_RPC_1=https://mainnet.optimism.io

# ── Frontend (Next.js) ──
NEXT_PUBLIC_API_URL=http://localhost:4000/api
